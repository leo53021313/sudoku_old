__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.pt.old
*.db.old
sb3/data/eval_puzzles.json
reasoner/data/puzzle_techniques.json
.superpowers/
reasoner/models/
reasoner/runs/
sb3/models/
sb3/runs/
apprentice/models/
apprentice/runs/

# Built deployment package for Drive upload (~60 MB, regenerated by demo/build_package.py)
dist-package/

# Claude Code per-project state
.claude/

# SQLite WAL/SHM working files — never commit
*.db-shm
*.db-wal
*.db-journal

# Apprentice DB backups & recovery artifacts
data/*.bak
data/*.bak.*
data/*.dead-*
data/*.pre-recov-*
data/*.recovered-*.db
data/*.corrupt
data/_recover-*/

# Visualizer smoke-test outputs (underscore-prefix = throwaway)
apprentice/demo/_*.png

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python virtualenvs (root-anchored so they don't shadow the apprentice/env/
# source package — a bare `env/` matches dirs at ANY depth and silently
# ignored new files under apprentice/env/).
/venv/
/.venv/
/env/

# Python build artifacts
*.egg-info/
build/
dist/

# Jupyter notebook checkpoints
.ipynb_checkpoints/
